{
  "name": "launch-observer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser extension to observe and inspect analytics network calls.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:css": "tailwindcss -i styles/tailwind.css -o styles/app.css --minify",
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:chrome": "node scripts/build-chrome.mjs",
    "build:all": "npm run build:chrome && npm run build:firefox"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "tailwindcss": "^3.4.13"
  }
}
